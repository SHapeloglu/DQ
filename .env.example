DB_HOST=dq-db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=dq
APP_HOST=0.0.0.0
APP_PORT=8000
METRICS_PG_DSN=postgresql://user:password@host:5432/dbname
METRICS_PG_PASSWORD=CHANGE_ME

# Airflow TOML credentials override (opsiyonel)
DQ_POSTGRES_USER=postgres
DQ_POSTGRES_PASSWORD=
DQ_POSTGRES_HOST=localhost
DQ_POSTGRES_PORT=5432
DQ_POSTGRES_DATABASE=dq_test

DQ_ORACLE_USER=system
DQ_ORACLE_PASSWORD=
DQ_ORACLE_HOST=localhost

DQ_MYSQL_USER=root
DQ_MYSQL_PASSWORD=
DQ_MYSQL_HOST=host.docker.internal

DQ_MONGODB_USER=
DQ_MONGODB_PASSWORD=
DQ_MONGODB_HOST=localhost

# secrets/.env.secrets dosyasına taşınacak (chmod 600)
DB_PASSWORD=
METRICS_PG_PASSWORD=
METRICS_PG_DSN=

# ── Giriş / yetki (genel yetki kapısı, auth.py) ──
# Oturum çerezlerini imzalar. Boş bırakılırsa her yeniden başlatmada rastgele üretilir (oturumlar düşer). Uzun rastgele bir değer verin.
DQ_SECRET_KEY=
# İlk "admin" kullanıcısının parolası (yalnız users tablosunda admin yokken kullanılır). Boş bırakılırsa rastgele üretilir ve logda BİR KEZ yazılır.
DQ_ADMIN_PASSWORD=
# Makine istemcileri (Airflow DAG'ı, Power BI OData) için servis anahtarı; "X-DQ-Token" başlığıyla gönderilir. Boşsa makine erişimi kapalıdır.
DQ_API_TOKEN=
